# ===== 飞书配置 =====
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== AI 模型配置 =====
# 主分析模型：DeepSeek（推荐，便宜 + 我们预搜索好数据）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Claude API（备选，最准确但较贵，支持 tool_use）
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API（免费版，每天1500次 — 用于图片视觉分析 + 备选文本分析）
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 搜索配置 =====
# Tavily Search API（用于 TRO/维权/市场/版权搜索）
# 注册地址: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 视觉模型配置（可选，默认用 Gemini）=====
# VISION_MODE=openai  # 或 gemini（默认）
# VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# ===== 服务配置 =====
PORT=8000
LOG_LEVEL=INFO
